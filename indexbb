  function tick(now){if(disposed)return;const dt=previous?Math.min(.035,(now-previous)/1000):0;previous=now;if(running&&!paused&&!finished){model.update(dt,{x:Number(held.has('right'))-Number(held.has('left')),y:Number(held.has('down'))-Number(held.has('up'))});score(model.points);if(model.over){finished=true;running=false;pause.disabled=true;shield.disabled=true;record(model.points);status(model.won?'Missão cumprida! Você resistiu a todas as ondas.':'Sua nave foi atingida. Tente uma nova rota!');}}hud.textContent=`${'♥'.repeat(Math.max(0,model.hp))}${'♡'.repeat(Math.max(0,3-model.hp))} · ${Math.floor(model.time)} / 90 s · Escudo: ${model.shield>0?'ATIVO':model.cooldown>0?Math.ceil(model.cooldown)+' s':'pronto'}`;draw();frame=requestAnimationFrame(tick)}cleanups.push(()=>{disposed=true;cancelAnimationFrame(frame);held.clear()});status('Destrua naves, desvie dos tiros e sobreviva por 90 segundos. Com 500 pontos, seus tiros ficam triplos.');frame=requestAnimationFrame(tick);
